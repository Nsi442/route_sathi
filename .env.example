# ---------------------------------------------------------------------------
# RouteSathi - environment configuration example
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=development
# Comma separated list of allowed CORS origins (only needed when the React dev
# server runs on a different port than the API).
CORS_ORIGINS=http://localhost:5173

# --- Database (Neon PostgreSQL + PostGIS) ---------------------------------
# Neon connection string. Use the *pooled* endpoint for serverless deployments.
# Format: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://routesathi:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/routesathi?sslmode=require
# When DATABASE_URL is not set, the API falls back to a local SQLite file
# (sqlite:///./routesathi.db) so the MVP can be run with zero configuration.

# --- Authentication (JWT) -------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Object storage (report evidence + resolution images) -----------------
# Works with any S3-compatible provider. Cloudflare R2 is the simplest and
# cheapest option (10 GB free, no egress fees); Amazon S3, Supabase Storage,
# Backblaze B2 and MinIO all work with the same four variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=routesathi-media

# On AWS EC2, attach an IAM role to the instance and set this to 1 instead of
# supplying keys. boto3 then reads temporary credentials from the instance
# metadata service, so nothing long-lived is stored on the server.
AWS_USE_INSTANCE_ROLE=0

# Leave EMPTY for Amazon S3. For another provider, set its endpoint:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   Supabase        https://<project>.supabase.co/storage/v1/s3
#   Backblaze B2    https://s3.<region>.backblazeb2.com
S3_ENDPOINT_URL=
# Lifetime of generated presigned GET urls, in seconds.
S3_PRESIGN_EXPIRY=900
# Largest accepted image upload, in bytes (default 8 MB).
MAX_UPLOAD_BYTES=8388608
# When S3 credentials are absent the API stores uploads in the database
# (development fallback only - see docs/S3.md).

# --- Machine learning -----------------------------------------------------
# Directory used to cache the trained XGBoost priority model.
ML_MODEL_DIR=/tmp/routesathi-ml
# Set to 0 to disable model training and use the deterministic rule engine.
ML_ENABLED=1

# --- Serving --------------------------------------------------------------
# Set to 1 to have the API also serve the built React app from dist/, so one
# process runs the whole product. Leave 0 when nginx serves the frontend.
SERVE_FRONTEND=0
FRONTEND_DIST=

# Host header allowlist, comma separated. "*" accepts anything, which is fine
# behind a reverse proxy on a single box.
TRUSTED_HOSTS=*

# --- Seeding --------------------------------------------------------------
# Password used by scripts/seed_data.py for the generated demo accounts.
SEED_DEFAULT_PASSWORD=Password123!
