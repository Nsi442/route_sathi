# ---------------------------------------------------------------------------
# RouteSathi — server environment
#
# Install to /etc/routesathi/routesathi.env, owned by root and chmod 600:
#
#   sudo install -d -m 750 /etc/routesathi
#   sudo cp deploy/env.example /etc/routesathi/routesathi.env
#   sudo chmod 600 /etc/routesathi/routesathi.env
#   sudo nano /etc/routesathi/routesathi.env
#
# This file holds real secrets. It lives outside the repository and is read by
# systemd, never committed.
# ---------------------------------------------------------------------------

APP_ENV=production

# --- Database --------------------------------------------------------------
# PostgreSQL on this same instance (what setup-ec2.sh creates):
DATABASE_URL=postgresql+psycopg://routesathi:CHANGE_ME@localhost:5432/routesathi
# Or a managed database instead — Neon, or Amazon RDS:
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# --- Authentication --------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Object storage --------------------------------------------------------
# Recommended on EC2: attach an IAM role to the instance and set no keys at
# all. boto3 reads temporary credentials from the instance metadata service,
# so nothing long-lived is ever stored on this server.
S3_BUCKET=routesathi-media
AWS_REGION=ap-south-1
AWS_USE_INSTANCE_ROLE=1

# Only if you are NOT using an instance role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_USE_INSTANCE_ROLE=0

# For Cloudflare R2 or another S3-compatible provider instead of Amazon S3:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

S3_PRESIGN_EXPIRY=900
MAX_UPLOAD_BYTES=8388608

# --- Machine learning ------------------------------------------------------
ML_ENABLED=1
ML_MODEL_DIR=/opt/routesathi/.model-cache

# --- Seeding ---------------------------------------------------------------
# The password deploy/seed.sh gives the demo accounts. Set this BEFORE seeding
# and you never have to go and change three published passwords afterwards.
SEED_DEFAULT_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# --- Serving ---------------------------------------------------------------
# 0 when nginx serves the frontend (the default and recommended setup).
# 1 to let the API serve it too, for a box without nginx.
SERVE_FRONTEND=0
FRONTEND_DIST=/opt/routesathi/dist

# Host header allowlist. Set to your domain and/or the instance public IP.
# "*" accepts anything, which is fine behind nginx on a single box.
TRUSTED_HOSTS=*

# Not needed when nginx proxies /api on the same origin. Set only if a
# browser on another origin calls this API directly.
CORS_ORIGINS=
